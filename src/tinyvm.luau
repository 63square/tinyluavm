return function(E,D,uE,la)local tp,tu=table.pack,table.unpack local K,F=tu(D.m,1,2)local z,P,J,Q local function M(A,fr)local a,c={},0 local n=#A for i=1,n-1 do c+=1 a[c]=z(A[i],fr)end if n>0 then local pk=P(A[n],fr)for i=1,pk.n do c+=1 a[c]=pk[i]end end return a,c end z=function(n,fr)local t,k,m=n[1],n[2],n[3]if t==4 then return K[k]elseif t==6 then return fr[k][m][1]elseif t==8 then return E[K[k]]elseif t==9 then return z(k,fr)[z(m,fr)]elseif t==10 then return P(n,fr)[1]elseif t==12 then return Q(k,fr)elseif t==13 then local r=M(k,fr)for _,kv in m do r[z(kv[1],fr)]=z(kv[2],fr)end return r elseif t==16 then return z(k,fr)and z(m,fr)elseif t==17 then return z(k,fr)or z(m,fr)end end P=function(n,fr)if n[1]==10 then local fn=z(n[2],fr)local a,c=M(n[3],fr)return tp(fn(tu(a,1,c)))elseif n[1]==5 then return fr.V end return tp(z(n,fr))end J=function(bl,fr)local v,x,r for _,it in bl[2]do local t,p,h,u=it[1],it[2],it[3],it[4]if t==20 then fr[p][h][1]=z(u,fr)elseif t==22 then E[K[p]]=z(h,fr)elseif t==23 then z(p,fr)[z(h,fr)]=z(u,fr)elseif t==30 or t==31 then v=M(h,fr)for j,s in p do if t==30 then fr.S[s][1]=v[j]else fr.S[s]={v[j]}end end elseif t==32 then v=h for _,e in p do if z(e[1],fr)then v=e[2]break end end r=v and J(v,fr)if r then return r end elseif t==33 then while z(p,fr)do x=J(h,fr)if x==M then break elseif x then return x end end elseif t==35 then for j=z(h,fr),z(u,fr)do fr.S[p]={j}x=J(it[5],fr)if x==M then break elseif x then return x end end elseif t==36 then v=M(u,fr)for k,vv in v[1],v[2],v[3] do fr.S[p]={k}fr.S[h]={vv}x=J(it[5],fr)if x==M then break elseif x then return x end end elseif t==37 then local o,c=M(p,fr)o.n=c return o elseif t==38 then return M elseif t==41 then z(p,fr)end end end Q=function(ix,pa)local Y=F[ix]local lr={}for i,u in Y.L do lr[i]=pa[u[1]][u[2]]end return function(...)local fr={S={},U=lr,V=tp(select(Y.np+1,...))}for i=1,Y.np do fr.S[i]={(select(i,...))}end local r=J(Y.b,fr)if r then return tu(r,1,r.n)end end end Q(1)()(D.u,uE,la)end
